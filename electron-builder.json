{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.desktoplyrics.app",
  "productName": "Desktop Lyrics",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "logo_icon.png",
    "logo_icon.svg",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "logo_icon.png",
      "to": "logo_icon.png"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "logo_icon.png",
    "extraResources": [
      {
        "from": "native/win-media-bridge.exe",
        "to": "native/win-media-bridge.exe"
      }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "icon": "logo_icon.png",
    "category": "public.app-category.music",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "darkModeSupport": true
  },
  "dmg": {
    "title": "Desktop Lyrics",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Desktop Lyrics"
  }
}